{
  "manifest_version": 3,
  "name": "Event Intake",
  "version": "0.1.0",
  "description": "Capture event leads and sync to Jane and other EHRs.",
  "permissions": ["storage", "identity", "alarms"],
  "host_permissions": ["http://localhost:3000/*"],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Event Intake"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  }
}
