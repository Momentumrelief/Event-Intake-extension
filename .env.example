# Database
DATABASE_URL="postgresql://eventintake:eventintake@localhost:5432/eventintake"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me-min-32-chars-in-production"
JWT_ACCESS_EXPIRY="1h"
JWT_REFRESH_EXPIRY="7d"

# API
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Encryption (for EHR OAuth tokens at rest)
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY="change-me-64-hex-chars-in-production"

# Jane (set after partner approval)
JANE_CLIENT_ID=""
JANE_CLIENT_SECRET=""
JANE_REDIRECT_URI="http://localhost:3000/auth/jane/callback"

# CORS origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,chrome-extension://*"
